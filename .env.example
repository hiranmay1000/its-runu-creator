# Set these in your hosting provider's server-side environment settings.
# Do not expose the access token as a VITE_* variable.
INSTAGRAM_ACCESS_TOKEN=replace_with_a_long_lived_meta_access_token
# Use the numeric Instagram professional account ID. Omit this to request the token owner's media as "me".
INSTAGRAM_USER_ID=replace_with_instagram_professional_account_id
